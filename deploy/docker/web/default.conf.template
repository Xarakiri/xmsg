# nginx's entrypoint fills in ${XMSG_*_UPSTREAM} at start. Each API prefix is stripped,
# as the Vite dev server does, so the services see their own paths.
map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

server {
  listen 8080;
  root /usr/share/nginx/html;
  client_max_body_size 1m;
  # Who's calling, for the per-address rate limits (auth's XMSG_PROXY_HOPS counts this hop).
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

  location /auth/      { proxy_pass http://${XMSG_AUTH_UPSTREAM}/; }
  location /channels/  { proxy_pass http://${XMSG_CHANNELS_UPSTREAM}/; }
  location /messages/  { proxy_pass http://${XMSG_MESSAGES_UPSTREAM}/; }
  location /users/     { proxy_pass http://${XMSG_USERS_UPSTREAM}/; }
  location /readstate/ { proxy_pass http://${XMSG_READSTATE_UPSTREAM}/; }
  location /push/      { proxy_pass http://${XMSG_PUSH_UPSTREAM}/; }

  location /ws {
    proxy_pass http://${XMSG_GATEWAY_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 1h;
  }

  # The service worker must never be cached stale.
  location = /sw.js { add_header Cache-Control "no-cache"; }

  # The single-page app: unknown paths load index.html.
  location / { try_files $uri /index.html; }
}
