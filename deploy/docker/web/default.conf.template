# nginx's entrypoint fills in ${XMSG_*_UPSTREAM} and ${XMSG_RESOLVER} at start. Each API
# prefix is stripped, as the Vite dev server does, so the services see their own paths.
#
# Upstreams are resolved per request, not at start: proxy_pass goes through a variable,
# so a recreated container (new IP) is found again without restarting web, and web starts
# before its upstreams exist. Variable proxy_pass does no prefix stripping of its own, so
# every API location rewrites its prefix off explicitly, then forwards the rewritten URI.
map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

server {
  listen 8080;
  root /usr/share/nginx/html;
  client_max_body_size 1m;
  # The container's DNS (127.0.0.11 in Compose, cluster DNS in Kubernetes), set from
  # /etc/resolv.conf by /docker-entrypoint.d/10-resolver.envsh; short TTL so recreated
  # upstreams are picked up quickly. No IPv6 records exist for these names.
  resolver ${XMSG_RESOLVER} valid=5s ipv6=off;
  # Who's calling, for the per-address rate limits (auth's XMSG_PROXY_HOPS counts this hop).
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

  location /auth/      { set $upstream ${XMSG_AUTH_UPSTREAM};      rewrite ^/auth/(.*)$ /$1 break;      proxy_pass http://$upstream; }
  location /channels/  { set $upstream ${XMSG_CHANNELS_UPSTREAM};  rewrite ^/channels/(.*)$ /$1 break;  proxy_pass http://$upstream; }
  location /messages/  { set $upstream ${XMSG_MESSAGES_UPSTREAM};  rewrite ^/messages/(.*)$ /$1 break;  proxy_pass http://$upstream; }
  location /users/     { set $upstream ${XMSG_USERS_UPSTREAM};     rewrite ^/users/(.*)$ /$1 break;     proxy_pass http://$upstream; }
  location /readstate/ { set $upstream ${XMSG_READSTATE_UPSTREAM}; rewrite ^/readstate/(.*)$ /$1 break; proxy_pass http://$upstream; }
  location /push/      { set $upstream ${XMSG_PUSH_UPSTREAM};      rewrite ^/push/(.*)$ /$1 break;      proxy_pass http://$upstream; }
  # Files (ADR-0024): streamed both ways, up to the media service's own limit (25 MB).
  # Calls (ADR-0025). Without calls or push this points at auth (404), as before.
  location /calls/     { set $upstream ${XMSG_CALLS_UPSTREAM};     rewrite ^/calls/(.*)$ /$1 break;     proxy_pass http://$upstream; }
  location /media/ {
    set $upstream ${XMSG_MEDIA_UPSTREAM};
    rewrite ^/media/(.*)$ /$1 break;
    proxy_pass http://$upstream;
    client_max_body_size 26m;
    proxy_request_buffering off;
    proxy_buffering off;
  }

  location /ws {
    set $upstream ${XMSG_GATEWAY_UPSTREAM};
    proxy_pass http://$upstream;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 1h;
  }

  # The service worker must never be cached stale.
  location = /sw.js { add_header Cache-Control "no-cache"; }

  # The single-page app: unknown paths load index.html.
  location / { try_files $uri /index.html; }
}
