{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xmsg",
  "version": "0.1.0",
  "identifier": "io.xmsg.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -w @xmsg/web",
    "beforeBuildCommand": "npm run build -w @xmsg/web",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "xmsg",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#14161c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self' https: http://localhost: http://127.0.0.1: ws: wss:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "13.0"
    }
  }
}
